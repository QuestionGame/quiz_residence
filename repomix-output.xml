      }

      #catalogSection .overflow-x-auto {
        overflow: visible !important;
      }

      #catalogSection table {
        min-width: 0 !important;
        font-size: 9pt;
      }

      #catalogSection thead {
        display: table-header-group;
      }

      #catalogSection tr {
        break-inside: avoid;
        page-break-inside: avoid;
      }

      #catalogSection tbody tr {
        border-bottom: 1px solid #ccc !important;
      }

      #catalogSection td > span.rounded-full {
