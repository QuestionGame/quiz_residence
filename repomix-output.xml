    :root {
      color-scheme: dark;
      --residence-ink: #0b0e14;
      --residence-surface: #141721;
      --residence-raised: #1b1e28;
      --residence-copper: #d96b43;
      --residence-copper-light: #e07a5f;
      --residence-champagne: #d4af37;
      --residence-text: #f5f2eb;
      --residence-muted: #a7a5a0;
      --residence-line: rgba(212, 175, 55, 0.18);
      --residence-safe-bottom: env(safe-area-inset-bottom, 0px);
    }

    html {
      background: var(--residence-ink);
      scroll-behavior: smooth;
      -webkit-tap-highlight-color: transparent;
    }

    body[data-page] {
      min-height: 100dvh;
      padding-bottom: calc(92px + var(--residence-safe-bottom));
