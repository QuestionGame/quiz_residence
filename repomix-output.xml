      font-family: "Plus Jakarta Sans", Inter, sans-serif;
      font-size: 15px;
      line-height: 1.6;
      letter-spacing: 0;
      background:
        radial-gradient(ellipse at 18% -18%, rgba(217, 107, 67, 0.1), transparent 44%),
        linear-gradient(180deg, #0b0e14 0%, #11141b 44%, #0b0e14 100%) !important;
    }

    body.sheet-is-open {
      overflow: hidden;
      touch-action: none;
    }

    button,
    input,
    select {
      font: inherit;
      letter-spacing: 0;
    }

    button,
    a,
    select,
    input[type="checkbox"] {
      touch-action: manipulation;
    }

    button:focus-visible,
    a:focus-visible,
    input:focus-visible,
    select:focus-visible {
      outline: 2px solid var(--residence-champagne);
      outline-offset: 3px;
    }

    .residence-header {
      position: sticky;
      top: 0;
      z-index: 40;
      color: var(--residence-text);
      background: rgba(11, 14, 20, 0.94);
      border-bottom: 1px solid var(--residence-line);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
    }

    .residence-header-main,
    .residence-search-area,
    .mode-nav,
    .residence-main {
      width: min(100% - 28px, 1120px);
      margin-inline: auto;
    }

    .residence-header-main {
      min-height: 66px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .residence-brand {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 10px;
      color: inherit;
      text-decoration: none;
    }

    .residence-monogram {
      width: 42px;
      height: 42px;
      flex: 0 0 42px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(212, 175, 55, 0.7);
      border-radius: 14px 14px 14px 5px;
      color: var(--residence-champagne);
      background: linear-gradient(145deg, rgba(217, 107, 67, 0.2), rgba(20, 23, 33, 0.95));
      font: 600 23px/1 Cinzel, Georgia, serif;
    }

    .residence-brand-copy {
      min-width: 0;
      display: grid;
      line-height: 1.2;
    }

    .residence-eyebrow,
    .section-kicker {
      color: var(--residence-copper-light);
      font: 600 10px/1.3 "Plus Jakarta Sans", sans-serif;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .residence-brand-title {
      overflow: hidden;
      color: var(--residence-text);
      font: 600 16px/1.25 Cinzel, Georgia, serif;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .residence-brand-subtitle {
      overflow: hidden;
      color: var(--residence-muted);
      font-size: 11px;
      text-overflow: ellipsis;
      white-space: nowrap;
