    .search-field {
      min-height: 52px;
      display: flex;
      align-items: center;
      gap: 11px;
      padding: 0 15px;
      border: 1px solid rgba(212, 175, 55, 0.24);
      border-radius: 16px;
      background: linear-gradient(120deg, rgba(20, 23, 33, 0.96), rgba(24, 25, 30, 0.92));
      box-shadow: inset 0 1px rgba(255, 255, 255, 0.035);
    }

    .search-field svg {
      width: 19px;
