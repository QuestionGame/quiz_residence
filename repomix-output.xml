  'РАВІОЛІ З КОПЧЕНОЮ КАЧКОЮ': 'Копчена качка, маскарпоне, пармезан, деміглас, цибулевий чатні, в\'ялені томати',
  'УДОН З ЯЛОВИЧИНОЮ ТОНКАЦУ': 'Пшенична локшина, телятина, стручкова квасоля, вершкове масло, чилі, пармезан',
  'ПЕЛЬМЕНІ З КРЕВЕТКАМИ ТА ФОРЕЛЛЮ СЛАБОЇ СОЛІ': 'Креветково-куряча начинка, грецький йогурт, кріп, вершкове масло, форель',
  'ЛАЗАНЬЄТТА': 'Болоньєзе з яловичини, бешамель, сирний соус з пармезану, унагі, базилік',
  'ПАСТА ЗІ ШНІЦЕЛЕМ': 'Томатно-вершковий соус, куряче стегно в паніровці',
  'РАВІОЛІ З РІКОТОЮ ТА ШПИНАТОМ': 'Рікота, шпинат, вершковий соус, пармезан, фісташкова крихта',
  'КУРЯЧИЙ БУЛЬЙОН З ФРИКАДЕЛЬКАМИ': 'Курячий бульйон, курячі мітболи, фреш паста, половинка яйця',
  'КУРЯЧІ МІТБОЛИ З КАРТОПЛЯНИМ ПЮРЕ': null,
  'СИРНИЧКИ ЗІ СМЕТАНОЮ': null,
  'ВЕРШКОВІ СПАГЕТТІ З ПАРМЕЗАНОМ': null,
  'ПШЕНИЧНИЙ ТАРТІН': null,
  'ЖИТНІЙ ТАРТІН': null,
  'ГРІНКИ ГРЕЧАНІ': null
};

const KITCHEN_SECTIONS = { 'НА СНІДАНОК': 'Сніданки', 'ПІЦА': 'Піца', 'НА ОБІД ТА ВЕЧЕРЮ': 'Обід та вечеря' };
const KITCHEN_CATEGORIES = {
  'СОЛОНЕ': 'Сніданок: солоне', 'СОЛОДКЕ': 'Сніданок: солодке', 'PIZZA': 'Піца', 'MINI PIZZA': 'Міні-піца',
  'ДЕСЕРТИ': 'Десерти', 'РИБА': 'Риба', 'СУПИ': 'Супи', "М'ЯСО": "М'ясо", 'ГАРНІРИ': 'Гарніри',
  'ЗАКУСКИ': 'Закуски', 'САЛАТИ': 'Салати', 'ПАСТА': 'Паста', 'ДІТКАМ': 'Дітям', 'ХЛІБ': 'Хліб'
};
const KITCHEN_NAMES = {
  'АНГЛІЙСКИЙ СНІДАНОК': 'АНГЛІЙСЬКИЙ СНІДАНОК',
  'MINI PIZZA|ПЕПЕРОНІ': 'ПЕПЕРОНІ МІНІ'
};

/* -------------------------------------------------------------- builders */

const report = { notCurated: [], excluded: [] };

function uniqueIds(items) {
  const seen = new Map();
  for (const item of items) {
    const base = item.id || 'item';
    const n = (seen.get(base) || 0) + 1;
    seen.set(base, n);
    if (n > 1) item.id = `${base}-${n}`;
  }
  return items;
}

function baseItem(raw, page, name) {
  const perHundred = /ціна (вказана )?за 100\s*г/i.test(raw['Опис']);
  return {
    id: slug(name),
    name,
    price: formatPrice(raw['Ціна (грн)'], perHundred),
    volume: perHundred ? '' : formatVolume(raw["Вага / Об'єм"]),
    notes: cleanDescription(raw['Опис']),
    imageUrl: raw['Фото'] || '',
    image: '',
    page
  };
}

function buildBar() {
  return uniqueIds(itemsOf(['БАР']).flatMap(raw => {
    const k = key(raw['Назва']);
    const answers = BAR[k];
    if (!answers) { report.notCurated.push(`БАР: ${raw['Назва']}`); return []; }
    const [type, country, style] = answers;
    const item = baseItem(raw, 'bar', BAR_NAMES[k] || norm(raw['Назва']));
    if (!item.notes) item.notes = BAR_NOTES[k] || '';
    return [{ ...item, group: BAR_GROUP_LABELS[key(raw['Категорія'])] || raw['Категорія'], type, country, style }];
  }));
}

function buildCocktails() {
  return uniqueIds(itemsOf(['КОКТЕЙЛІ']).flatMap(raw => {
    const groupKey = key(raw['Категорія']);
    const k = `${groupKey}|${key(raw['Назва'])}`;
    const answers = COCKTAILS[k];
    if (!answers) { report.notCurated.push(`КОКТЕЙЛІ: ${raw['Категорія']} / ${raw['Назва']}`); return []; }
    const group = COCKTAIL_GROUP_LABELS[groupKey];
    const isZero = groupKey === 'БЕЗАЛКОГОЛЬНІ';
    const name = isZero ? `${norm(raw['Назва'])} б/а` : norm(raw['Назва']);
    const [base, ingredients] = answers;
    return [{ ...baseItem(raw, 'cocktails', name), group, base, ingredients }];
  }));
}

function buildKitchen() {
  return uniqueIds(itemsOf(Object.keys(KITCHEN_SECTIONS)).flatMap(raw => {
    const nameKey = key(raw['Назва']);
    const catKey = key(raw['Категорія']);
    if (!(nameKey in KITCHEN)) { report.notCurated.push(`КУХНЯ: ${raw['Назва']}`); return []; }
    const name = KITCHEN_NAMES[`${catKey}|${nameKey}`] || KITCHEN_NAMES[nameKey] || norm(raw['Назва']);
    const item = baseItem(raw, 'menu', name);
    const composition = KITCHEN[nameKey];
    const weight = item.volume || null;
    // Need at least two answerable questions (category is always known) to be worth quizzing.
    if (!composition && !weight) { report.excluded.push(`КУХНЯ: ${name} (немає опису і ваги)`); return []; }
    return [{
      ...item,
      group: KITCHEN_SECTIONS[key(raw['Розділ'])],
      category: KITCHEN_CATEGORIES[catKey] || raw['Категорія'],
      composition,
      weight
    }];
  }));
}

/* ---------------------------------------------------------------- images */

async function downloadImages(items, folder) {
  const dir = path.join(ROOT, IMG_DIR, folder);
  fs.mkdirSync(dir, { recursive: true });
  for (const item of items) {
    if (!item.imageUrl) continue;
    const file = `${item.id}.webp`;
    const target = path.join(dir, file);
    if (DOWNLOAD_IMAGES && !fs.existsSync(target)) {
      try {
        const res = await fetch(item.imageUrl);
        const type = res.headers.get('content-type') || '';
        if (!res.ok || !type.startsWith('image/')) throw new Error(`${res.status} ${type}`);
        fs.writeFileSync(target, Buffer.from(await res.arrayBuffer()));
      } catch (error) {
        console.warn(`  ! фото не завантажено: ${item.name} (${error.message})`);
      }
    }
    if (fs.existsSync(target)) item.image = `./${IMG_DIR}/${folder}/${file}`;
  }
}

function write(file, items) {
  const clean = items.map(({ imageUrl, page, ...rest }) => rest);
  fs.writeFileSync(path.join(DATA_DIR, file), JSON.stringify(clean, null, 2) + '\n');
  console.log(`data/${file}: ${clean.length} позицій, з фото: ${clean.filter(i => i.image).length}`);
}

const pages = [
  ['bar.json', 'bar', buildBar()],
  ['cocktails.json', 'cocktails', buildCocktails()],
  ['menu.json', 'menu', buildKitchen()]
];
for (const [file, folder, items] of pages) {
  await downloadImages(items, folder);
  write(file, items);
}

if (report.notCurated.length) {
  console.log('\nNOT CURATED (додайте відповіді в scripts/build_quiz_data.mjs):');
  report.notCurated.forEach(line => console.log(`  - ${line}`));
}
if (report.excluded.length) {
  console.log('\nПропущено:');
  report.excluded.forEach(line => console.log(`  - ${line}`));
}
